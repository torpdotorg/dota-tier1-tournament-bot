{
  "name": "dota-tier1-tournament-bot",
  "version": "2.3.5",
  "private": true,
  "description": "Catalog-driven Tier 1 Dota 2 tournament platform",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/register-commands.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "validate-release": "node scripts/validate-release.js",
    "release-check": "npm run check && npm test && npm run validate-release",
    "simulate-tournament": "node scripts/simulate-tournament.js",
    "validate-platform": "npm run release-check && npm run simulate-tournament"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "node-cron": "^4.6.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
